# 复制为 .env 后填入真实值（.env 不会进仓库）
#
# 变量名支持两套，标准名优先：
#   MYSQL_*（部署脚本 / CI 用，与 ReviewMaster 一致）
#   DB_*   （历史本地 .env 用的旧名，仍然有效）
# 每项后面的「默认 …」是代码里未配置时的取值，留空即使用默认值。
# 注意：值后面不要跟行内注释，.env 解析器会把注释一起当成值。

# 默认 127.0.0.1
MYSQL_HOST=127.0.0.1
# 默认 3306
MYSQL_PORT=3306
# 默认 root
MYSQL_USER=root
# 默认空（Docker 本地容器的 root 口令是 ppz7long）
MYSQL_PASSWORD=your_mysql_password
# 默认 goldenkey
MYSQL_DATABASE=goldenkey

# token 签名密钥：AUTH_SECRET 优先，兼容旧的 JWT_SECRET
# 默认 goldenkey-dev-secret（仅开发用），部署时务必改成随机长字符串
AUTH_SECRET=change-me-in-production
